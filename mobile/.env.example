# Gemini API Key (Used by Vite for the AI features in the frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare R2 Storage (Used by serverless API functions for secure uploads)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_PUBLIC_DOMAIN=https://your-r2-public-domain.r2.dev

# JigsawStack API Key (Optional / Legacy)
JIGSAWSTACK_API_KEY=your_jigsawstack_api_key_here

# Turso Database Configurations
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here